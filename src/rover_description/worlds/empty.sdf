<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="rough_terrain_world">
   
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.55 0.5 1.0</ambient>
      <background>0.75 0.65 0.55 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional Sun Light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Flat Base Ground with Surface Friction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.35 0.25 1</ambient>
            <diffuse>0.6 0.42 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rolling Mounds / Uneven Dunes -->
    <model name="dune_field">
      <static>true</static>
      <link name="link">
        <!-- Mound 1 -->
        <collision name="c_mound_1">
          <pose>2.5 0.5 -0.35 0 0 0</pose>
          <geometry>
            <sphere><radius>0.9</radius></sphere>
          </geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="v_mound_1">
          <pose>2.5 0.5 -0.35 0 0 0</pose>
          <geometry>
            <sphere><radius>0.9</radius></sphere>
          </geometry>
          <material><diffuse>0.65 0.45 0.32 1</diffuse></material>
        </visual>

        <!-- Mound 2 (Staggered for suspension roll) -->
        <collision name="c_mound_2">
          <pose>3.8 -0.4 -0.4 0 0 0</pose>
          <geometry>
            <sphere><radius>1.0</radius></sphere>
          </geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="v_mound_2">
          <pose>3.8 -0.4 -0.4 0 0 0</pose>
          <geometry>
            <sphere><radius>1.0</radius></sphere>
          </geometry>
          <material><diffuse>0.62 0.42 0.30 1</diffuse></material>
        </visual>

        <!-- Mound 3 -->
        <collision name="c_mound_3">
          <pose>5.2 0.3 -0.45 0 0 0</pose>
          <geometry>
            <sphere><radius>1.1</radius></sphere>
          </geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="v_mound_3">
          <pose>5.2 0.3 -0.45 0 0 0</pose>
          <geometry>
            <sphere><radius>1.1</radius></sphere>
          </geometry>
          <material><diffuse>0.65 0.45 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rock Obstacle Field -->
    <model name="rock_field">
      <static>true</static>
      <link name="link">
        <!-- Rock 1 -->
        <collision name="c_rock_1">
          <pose>1.8 -0.35 0.05 0.2 0.3 0.5</pose>
          <geometry><box><size>0.22 0.28 0.12</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_rock_1">
          <pose>1.8 -0.35 0.05 0.2 0.3 0.5</pose>
          <geometry><box><size>0.22 0.28 0.12</size></box></geometry>
          <material><diffuse>0.45 0.32 0.24 1</diffuse></material>
        </visual>

        <!-- Rock 2 -->
        <collision name="c_rock_2">
          <pose>2.8 0.4 0.06 -0.1 0.4 1.1</pose>
          <geometry><box><size>0.3 0.25 0.14</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_rock_2">
          <pose>2.8 0.4 0.06 -0.1 0.4 1.1</pose>
          <geometry><box><size>0.3 0.25 0.14</size></box></geometry>
          <material><diffuse>0.42 0.30 0.22 1</diffuse></material>
        </visual>

        <!-- Rock 3 -->
        <collision name="c_rock_3">
          <pose>4.2 -0.25 0.08 0.3 -0.2 0.8</pose>
          <geometry><box><size>0.26 0.32 0.16</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_rock_3">
          <pose>4.2 -0.25 0.08 0.3 -0.2 0.8</pose>
          <geometry><box><size>0.26 0.32 0.16</size></box></geometry>
          <material><diffuse>0.48 0.35 0.26 1</diffuse></material>
        </visual>

        <!-- Small Rock Cluster -->
        <collision name="c_rock_4">
          <pose>3.4 0.1 0.04 0.1 0.1 0.2</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_rock_4">
          <pose>3.4 0.1 0.04 0.1 0.1 0.2</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry>
          <material><diffuse>0.5 0.37 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Articulation Steps (Tests Rocker-Bogie Pitch & Compliance) -->
    <model name="suspension_test_steps">
      <static>true</static>
      <pose>7.0 0 0 0 0 0</pose>
      <link name="link">
        <!-- Step 1: 0.06m height -->
        <collision name="c_step_1">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>1.0 2.5 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_step_1">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>1.0 2.5 0.06</size></box></geometry>
          <material><diffuse>0.55 0.38 0.28 1</diffuse></material>
        </visual>

        <!-- Step 2: Additional 0.08m lift -->
        <collision name="c_step_2">
          <pose>1.0 0 0.07 0 0 0</pose>
          <geometry><box><size>1.0 2.5 0.14</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v_step_2">
          <pose>1.0 0 0.07 0 0 0</pose>
          <geometry><box><size>1.0 2.5 0.14</size></box></geometry>
          <material><diffuse>0.58 0.40 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sloped Incline Ramp (15 Degree Test Ramp) -->
    <model name="incline_ramp">
      <static>true</static>
      <pose>10.5 0 0.25 0 0.26 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.8</mu><mu2>1.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.52 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles for LiDAR and PointCloud2 Detection -->
    <model name="box_obstacle">
      <static>true</static>
      <pose>3.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.25 0.15 1</ambient>
            <diffuse>0.85 0.3 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>3.5 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.6 0.8 1</ambient>
            <diffuse>0.2 0.7 0.9 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Required Gazebo Sim Plugins -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>
  </world>
</sdf>